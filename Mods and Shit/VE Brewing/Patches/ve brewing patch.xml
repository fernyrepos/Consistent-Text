<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<!-- A small, rolled paper tube stuffed loosely with tobacco leaves. Offers a brief euphoria as well as mental stimulation, and is very addictive. The pungent odor is generally disliked at first, but becomes much more pleasurable as the smoker becomes more addicted. Can be crafted without equipment, at a crafting spot. -->
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="VBE_Cigarettes"]/description</xpath>
        <value>
            <description>A small, rolled paper tube loosely filled with tobacco leaves. The drug offers brief euphoria, mental stimulation, and a decreased appetite. The pungent odor becomes much more pleasurable as the smoker becomes more addicted.\n\nCigarettes can be crafted without equipment at a crafting spot.</description>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>Defs/ThingDef[defName="VBE_Cigarettes"]</xpath>
        <value>
            <descriptionHyperlinks>
                <HediffDef>VBE_TobaccoHigh</HediffDef>
                <HediffDef>VBE_TobaccoTolerance</HediffDef>
                <HediffDef>VBE_TobaccoAddiction</HediffDef>
                <HediffDef>Carcinoma</HediffDef>
                <HediffDef>Asthma</HediffDef>
            </descriptionHyperlinks>
        </value>
    </Operation>

<!-- Nicotine in the bloodstream. Generates a soft feeling of fuzzy well-being. -->
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/HediffDef[defName="VBE_TobaccoHigh"]/description</xpath>
        <value>
            <description>Nicotine in the bloodstream. Generates a warm, tingling sensation.</description>
        </value>
    </Operation>

<!-- Nicotine in the bloodstream. Generates a soft feeling of fuzzy well-being. -->
    <Operation Class="PatchOperationReplace">
        <success>Always</success>
        <xpath>Defs/HediffDef[defName="VBE_DeluxeTobaccoHigh"]/description</xpath>
        <value>
            <description>Nicotine in the bloodstream. Generates a warm, tingling sensation.</description>
        </value>
    </Operation>

</Patch>