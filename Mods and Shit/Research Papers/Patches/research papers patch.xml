<?xml version="1.0" encoding="utf-8" ?>          
<Patch>
        <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="ResearchPaper"]/label</xpath>
            <value>
                <label>knowledge</label>
            </value>
        </Operation>

        <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="ResearchPaper"]/description</xpath>
            <value>
                <description>Papers containing the completed notes of your full understanding of a topic. Losing it results in a loss of its knowledge.</description>
            </value>
        </Operation>

        <Operation Class="PatchOperationReplace">
            <xpath>Defs/RulePackDef[defName="Namer_ResearchPaper"]/rulePack/rulesStrings</xpath>
            <value>
                <rulesStrings>
                    <li>title->Knowledge of [subject_primary]</li>
                    <li>title(has_subject_secondary==true)->Knowledge of [subject_primary] and [subject_secondary]</li>
                </rulesStrings>
            </value>
        </Operation>

        <!-- An advanced, high-density digital storage server designed to archive research findings. Instead of taking up entire rooms with dusty paper, a single datacore can hold thousands of research papers, preserving knowledge efficiently. Built tough, it can withstand multiple explosions and is entirely fireproof.

        Drawback: Provides no boost to research speed. -->
        <Operation Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="ResearchServer"]/description</xpath>
            <value>
                <description>An advanced digital storage server designed to store massive amounts of research knowledge efficiently. It can withstand explosions and is fireproof. Does not provide a boost to nearby research benches.</description>
            </value>
        </Operation>

</Patch>
